<!--
  Copyright (c) 2026 Asymm Systems (Pvt) Ltd. All rights reserved.
  Application: build-time generator (S2). Thin entry point - depends only on the wiring
  assembly and the contracts it references; no svc-* (impl) dependencies.
  Volatility-based structure - see architecture/module-structure.md.

  @author Fahim Farook
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>systems.asymm.cipn</groupId>
        <artifactId>canipraynow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>

    <artifactId>cipn-app-batch</artifactId>
    <packaging>jar</packaging>

    <name>cipn-app-batch</name>
    <description>Application: build-time generator (S2). Thin - depends only on the wiring assembly.</description>

    <dependencies>
        <!-- The app depends on the wiring assembly, never on impl (svc-*) modules. -->
        <dependency>
            <groupId>systems.asymm.cipn</groupId>
            <artifactId>cipn-wiring-assembly-standard</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Contract types the entry point references (SiteGenerationManager/Result). -->
        <dependency>
            <groupId>systems.asymm.cipn</groupId>
            <artifactId>cipn-fw-contract-manager</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The astronomy-parity integration test drives the engine + method accessor impls directly. -->
        <dependency>
            <groupId>systems.asymm.cipn</groupId>
            <artifactId>cipn-svc-engine</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>systems.asymm.cipn</groupId>
            <artifactId>cipn-svc-accessor-file</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
