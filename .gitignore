# OS
.DS_Store
Thumbs.db

# City content pages — generated by the reactor (cipn-app-batch, S2) into the JBake
# content tree by `make generate`. Source of truth is the XML dataset; never hand-edit
# or commit these.
**/src/main/jbake/content/*/
!**/src/main/jbake/content/q/

# Dev-only tool deps (pdfjs for scripts/fetch-timetables.mjs) - never committed
node_modules/
