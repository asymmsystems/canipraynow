<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2026 Asymm Systems. All rights reserved.
  Scraper (Authority = JAKIM): fetches Malaysia's e-Solat JSON API and normalises it into the
  framework AuthorityTimetable (S1, ADR-0017). Off-build data acquisition - hits third-party
  sites, so it is never part of the Maven build; run by hand via `make scrape`.
  Volatility-based structure - see architecture/module-structure.md.

  @author Fahim Farook
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>systems.asymm.cipn</groupId>
        <artifactId>canipraynow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../..</relativePath>
    </parent>

    <artifactId>cipn-svc-scraper</artifactId>
    <packaging>jar</packaging>

    <name>cipn-svc-scraper</name>
    <description>Scraper (Authority = JAKIM): fetches e-Solat and normalises it into AuthorityTimetable (S1, ADR-0017).</description>

    <dependencies>
        <dependency>
            <groupId>systems.asymm.cipn</groupId>
            <artifactId>cipn-fw-contract-scrape</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- The e-Solat feed is JSON; jackson-databind reads it. (This module runs on the JVM
             off-build, not in WASM, so full Jackson is fine here - unlike the browser engine.) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>
        </plugins>
    </build>
</project>
