<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2026 Asymm Systems (Pvt) Ltd. All rights reserved.

  canipraynow.com - reactor (Maven multi-module root).
  Layered, volatility-based structure mirroring m360-code-system:
  framework / service / application / wiring. See architecture/module-structure.md.
  Standalone parent for now (asymm-build-parent adoption is a later step).

  @author Fahim Farook
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>systems.asymm.cipn</groupId>
    <artifactId>canipraynow</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>canipraynow</name>
    <description>Can I Pray Now - reactor (Asymm Systems)</description>

    <modules>
        <!-- framework: utilities + contracts (the volatility firewall) -->
        <module>framework/cipn-fw-common</module>
        <module>framework/cipn-fw-contract</module>

        <!-- service: engine (business logic), accessors (by location), managers (orchestration) -->
        <module>service/cipn-svc-engine</module>
        <module>service/cipn-svc-accessor-file</module>
        <module>service/cipn-svc-manager</module>

        <!-- application: the clients -->
        <module>application/cipn-app-site</module>
        <module>application/cipn-app-server</module>
        <module>application/cipn-app-batch</module>

        <!-- wiring: composition, mirroring the services -->
        <module>wiring/cipn-wiring-engine-default</module>
        <module>wiring/cipn-wiring-accessor-file</module>
        <module>wiring/cipn-wiring-manager-default</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jbake.version>2.7.0-rc.7</jbake.version>
        <jbake.plugin.version>2.7.0-rc.7</jbake.plugin.version>
        <freemarker.version>2.3.33</freemarker.version>
        <sass.plugin.version>1.5.0</sass.plugin.version>
        <dart.sass.version>1.83.0</dart.sass.version>
        <minify.plugin.version>1.7.11</minify.plugin.version>
        <htmlcompressor.plugin.version>2.1.1</htmlcompressor.plugin.version>
        <exec.plugin.version>3.1.0</exec.plugin.version>
        <skip.optimize>false</skip.optimize>
    </properties>
</project>
