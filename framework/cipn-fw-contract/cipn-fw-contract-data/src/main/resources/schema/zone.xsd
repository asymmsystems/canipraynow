  Standard schema for a country's zone index (zone.xml). One per country/year, at
  timetable/<year>/<cc>/zone.xml. Names the authority and lists its zones, each with a
  representative centroid and optional per-district minute adjustments (used by computed
  E2 countries; absent for table authorities).

  Country-independent: every authority is normalised by S1 into this same shape.
  Namespace-unaware; attributes are lower-case kebab-case.

  @author Fahim Farook
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <xs:element name="zones">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="zone" type="zone" minOccurs="1" maxOccurs="unbounded"/>
            </xs:sequence>
            <!-- Short authority code, e.g. "ACJU". -->
            <xs:attribute name="authority" type="xs:string" use="required"/>
            <!-- Full authority name, e.g. "All Ceylon Jamiyyathul Ulama". -->
            <xs:attribute name="authority-name" type="xs:string" use="required"/>
            <!-- Public URL the timetables were sourced from. -->
            <xs:attribute name="authority-url" type="xs:anyURI" use="required"/>
            <!-- Display name of the country, e.g. "Sri Lanka". -->
            <xs:attribute name="country" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="zone">
        <!-- The authority's own zone identifier, verbatim, e.g. "01". Must match the
             zone-<id>.xml file in the same folder. -->
        <xs:attribute name="id" type="xs:string" use="required"/>
        <!-- Human-readable coverage, e.g. "Colombo, Gampaha, Kalutara". -->
        <xs:attribute name="name" type="xs:string" use="required"/>
        <!-- Representative latitude of the zone in decimal degrees (snap target). -->
        <xs:attribute name="lat" type="xs:decimal" use="required"/>
        <!-- Representative longitude of the zone in decimal degrees. -->
        <xs:attribute name="lng" type="xs:decimal" use="required"/>
        <!-- Optional per-district minute adjustments for computed (E2) zones. Absent = 0. -->
        <xs:attribute name="adjust-fajr" type="xs:integer"/>
        <xs:attribute name="adjust-sunrise" type="xs:integer"/>
        <xs:attribute name="adjust-dhuhr" type="xs:integer"/>
        <xs:attribute name="adjust-asr" type="xs:integer"/>
        <xs:attribute name="adjust-maghrib" type="xs:integer"/>
        <xs:attribute name="adjust-isha" type="xs:integer"/>
    </xs:complexType>

</xs:schema>
