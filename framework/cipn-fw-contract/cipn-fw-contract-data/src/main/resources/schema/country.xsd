<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2026 Asymm Systems (Pvt) Ltd. All rights reserved.

  Standard schema for country.xml: the per-country authority register (T-01/T-27).
  One row per ISO-3166 alpha-2 country code. Carries both the presentation defaults shown
  on each city page (authority name, calculation-method phrase, predominant madhhab) and the
  authority-first source decision (feed obtainability, redistribution rights, confidence).
  Namespace-unaware; attributes are lower-case kebab-case.

  Source-of-truth policy (authority-first): where a national authority publishes an obtainable
  machine-readable table we serve THEIR numbers (served-by="authority"); otherwise we COMPUTE
  with the authority's stated method (served-by="computed"). method-key/method are recorded for
  every country regardless, since compute is always the fallback path.

  @author Fahim Farook
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <xs:element name="countries">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="country" type="country" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="country">
        <!-- ISO 3166-1 alpha-2 country code, upper-case. -->
        <xs:attribute name="cc" type="countryCode" use="required"/>
        <!-- false where the country has no official national prayer-time body; when false, put the
             one-line reason in note. Optional; absent is read as true. -->
        <xs:attribute name="has-authority" type="xs:boolean" use="optional"/>
        <!-- The official authority's display name, e.g. "All Ceylon Jamiyyathul Ulama (ACJU)".
             Empty where the country has no named authority (see has-authority). -->
        <xs:attribute name="authority" type="xs:string" use="required"/>
        <!-- The authority's official URL. Optional. -->
        <xs:attribute name="authority-url" type="xs:string" use="optional"/>
        <!-- The calculation-method phrase shown on city pages, e.g. "the Umm al-Qura convention". -->
        <xs:attribute name="method" type="xs:string" use="required"/>
        <!-- The calculation-method KEY (maps to calculation-method.xml), read to compute a
             non-covered city's times, e.g. "UmmAlQura". Recorded for every country (compute is the fallback). -->
        <xs:attribute name="method-key" type="xs:string" use="required"/>
        <!-- The predominant madhhab display name, e.g. "Ḥanbalī". May be empty. -->
        <xs:attribute name="madhhab" type="xs:string" use="required"/>
        <!-- The source-of-truth decision: "authority" = we serve the authority's own scraped table;
             "computed" = we compute with method-key. Optional; absent is read as "computed". -->
        <xs:attribute name="served-by" type="servedBy" use="optional"/>
        <!-- The authority's feed type for its published table. -->
        <xs:attribute name="feed" type="feed" use="optional"/>
        <!-- Whether the authority's table may be redistributed. Drives the redistribution feature flag. -->
        <xs:attribute name="redistributable" type="redistributable" use="optional"/>
        <!-- The terms URL or one-line basis for the redistributable answer (esp. where "unknown"). -->
        <xs:attribute name="redistributable-basis" type="xs:string" use="optional"/>
        <!-- Verification confidence for this row. -->
        <xs:attribute name="confidence" type="confidence" use="optional"/>
        <!-- The source URL(s) verified against (space- or comma-separated). -->
        <xs:attribute name="source-url" type="xs:string" use="optional"/>
        <!-- Free-text note: deviation/obtainability evidence, or the has-authority=false reason. -->
        <xs:attribute name="note" type="xs:string" use="optional"/>
        <!-- Optional public-facing sentence shown on the country's city pages, explaining a notable
             method choice (e.g. why times are computed rather than taken from the local authority's
             own table). Distinct from the internal, technical `note`. -->
        <xs:attribute name="method-note" type="xs:string" use="optional"/>
    </xs:complexType>

    <xs:simpleType name="countryCode">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]{2}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="servedBy">
        <xs:restriction base="xs:string">
            <xs:enumeration value="authority"/>
            <xs:enumeration value="computed"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="feed">
        <xs:restriction base="xs:string">
            <xs:enumeration value="api"/>
            <xs:enumeration value="html"/>
            <xs:enumeration value="pdf"/>
            <xs:enumeration value="image"/>
            <xs:enumeration value="app"/>
            <xs:enumeration value="none"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="redistributable">
        <xs:restriction base="xs:string">
            <xs:enumeration value="yes"/>
            <xs:enumeration value="no"/>
            <xs:enumeration value="unknown"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="confidence">
        <xs:restriction base="xs:string">
            <xs:enumeration value="high"/>
            <xs:enumeration value="medium"/>
            <xs:enumeration value="low"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
