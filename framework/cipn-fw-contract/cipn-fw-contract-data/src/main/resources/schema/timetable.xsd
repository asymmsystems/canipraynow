<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2026 Asymm Systems (Pvt) Ltd. All rights reserved.

  Standard schema for one zone's annual timetable (zone-<id>.xml), at
  timetable/<year>/<cc>/zone-<id>.xml. Holds the authority's published prayer times for
  that zone, one row per calendar day, including solar-noon so the client needs no runtime
  zenith computation. Times are minutes from local midnight.

  Country-independent: S1 normalises every authority's published table (HTML, PDF, JSON)
  into this shape. Namespace-unaware; attributes are lower-case kebab-case.

  @author Fahim Farook
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified">

    <xs:element name="timetable">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="day" type="day" minOccurs="1" maxOccurs="366"/>
            </xs:sequence>
            <!-- Short authority code, e.g. "ACJU". Matches zone.xml/@authority. -->
            <xs:attribute name="authority" type="xs:string" use="required"/>
            <!-- The zone id this table belongs to; matches the zone-<id>.xml suffix. -->
            <xs:attribute name="zone" type="xs:string" use="required"/>
            <!-- Human-readable coverage, e.g. "Colombo, Gampaha, Kalutara". -->
            <xs:attribute name="name" type="xs:string" use="required"/>
            <!-- Public URL this table was sourced from. -->
            <xs:attribute name="source" type="xs:anyURI" use="required"/>
            <!-- The unit of the time attributes below. Fixed: minutes from local midnight. -->
            <xs:attribute name="unit" type="timeUnit" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:complexType name="day">
        <!-- Calendar month, 1-12. -->
        <xs:attribute name="month" type="month" use="required"/>
        <!-- Day of month, 1-31. -->
        <xs:attribute name="day" type="dayOfMonth" use="required"/>
        <!-- Fajr, minutes from midnight. -->
        <xs:attribute name="fajr" type="minuteOfDay" use="required"/>
        <!-- Sunrise, minutes from midnight. -->
        <xs:attribute name="sunrise" type="minuteOfDay" use="required"/>
        <!-- Dhuhr, minutes from midnight. -->
        <xs:attribute name="dhuhr" type="minuteOfDay" use="required"/>
        <!-- Asr, minutes from midnight. -->
        <xs:attribute name="asr" type="minuteOfDay" use="required"/>
        <!-- Maghrib, minutes from midnight. -->
        <xs:attribute name="maghrib" type="minuteOfDay" use="required"/>
        <!-- Isha, minutes from midnight. -->
        <xs:attribute name="isha" type="minuteOfDay" use="required"/>
        <!-- Solar noon (zenith), minutes from midnight. Baked so the client skips zenith math. -->
        <xs:attribute name="solar-noon" type="minuteOfDay" use="required"/>
    </xs:complexType>

    <xs:simpleType name="timeUnit">
        <xs:restriction base="xs:string">
            <xs:enumeration value="minutes-from-midnight"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="month">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="12"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="dayOfMonth">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1"/>
            <xs:maxInclusive value="31"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="minuteOfDay">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="0"/>
            <xs:maxInclusive value="1439"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
